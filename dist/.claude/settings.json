{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git -C .. add:*)",
      "Bash(git -C .. commit:*)",
      "Bash(git -C .. push:*)"
    ],
    "allow": [
      "Bash(git -C .. ls-files:*)",
      "Bash(git -C .. grep:*)",
      "Bash(git -C .. status:*)",
      "Bash(git -C .. diff:*)",
      "Bash(git -C .. log:*)",
      "Bash(git -C .. rev-parse:*)",
      "Bash(git -C .. show:*)"
    ],
    "additionalDirectories": [
      ".."
    ]
  }
}
