#!/usr/bin/env sh
# vnetcon-ai — käynnistin. Toteutus on vnetcon-ai.mjs (Node).
#
# Tämä tiedosto on olemassa, jotta tuttu komento toimii ennallaan:
#   ./tyokalut/vnetcon-ai/vnetcon-ai <komento>
#
# Windowsilla käytä vnetcon-ai.cmd / vnetcon-ai.ps1 tai suoraan:
#   node tyokalut\vnetcon-ai\vnetcon-ai.mjs <komento>

set -eu

DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if ! command -v node >/dev/null 2>&1; then
  echo "vnetcon-ai: node puuttuu — tarvitaan Node 18+. Asenna: https://nodejs.org" >&2
  exit 1
fi

exec node "$DIR/vnetcon-ai.mjs" "$@"
